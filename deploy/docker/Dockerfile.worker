# Stage 1: Dependencies
FROM node:20.14.0-alpine3.20 AS deps
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# Stage 2: Build Stage
FROM node:20.14.0-alpine3.20 AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production
RUN npx prisma generate && npx tsc --noEmit || true

# Stage 3: BullMQ Background Worker Runner
FROM node:20.14.0-alpine3.20 AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 workeruser

COPY --from=builder --chown=workeruser:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=workeruser:nodejs /app/package.json ./package.json
COPY --from=builder --chown=workeruser:nodejs /app/prisma ./prisma
COPY --from=builder --chown=workeruser:nodejs /app/src ./src

USER workeruser

CMD ["npx", "ts-node", "src/server/workers/index.ts"]
