# ==============================================================================
# TeslaPrimeCapital — Coolify Production Secret Vault Template
# Inject these exact keys via Coolify environment variable management console.
# NEVER commit populated values to Git repository.
# ==============================================================================

NODE_ENV=production
PORT=3000

# Database Connection Strings (PostgreSQL 16+ via PgBouncer / Direct)
DATABASE_URL="postgresql://user:securepassword@pgbouncer-host:6432/teslaprime?pgbouncer=true"
DIRECT_URL="postgresql://user:securepassword@postgres-master-host:5432/teslaprime"

# Redis Cache & BullMQ Cluster Connection
REDIS_URL="redis://:secureredispassword@redis-cluster-host:6379/0"

# Cryptographic Token Secrets (Must be 64-char secure random hex strings)
JWT_ACCESS_SECRET="generate_64_character_cryptographic_random_hex_key_here"
JWT_REFRESH_SECRET="generate_64_character_cryptographic_random_hex_key_here"
SESSION_MASTER_KEY="generate_aes_256_gcm_master_encryption_key_here"

# Cloudinary Media Storage (Public CDN + Authenticated Private KYC Folders)
CLOUDINARY_CLOUD_NAME="teslaprime"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Resend Transactional Email Delivery Gateway
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Platform Domain & Application Base URL
NEXT_PUBLIC_APP_URL="https://teslaprimecapital.com"
