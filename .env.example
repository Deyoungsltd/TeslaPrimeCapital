# ============================================================================
# TeslaPrimeCapital — Environment Variable Registry
# Copy this file to `.env.local` and fill in each value for local development.
# ============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teslaprimecapital?schema=public"

# --- Redis Cluster / Cache ---
REDIS_URL="redis://localhost:6379/0"

# --- Authentication Cryptography ---
JWT_ACCESS_SECRET=""
SESSION_MASTER_KEY=""

# --- Transactional Email (Resend) ---
# Sign up at resend.com, verify your sending domain, then paste the API key.
# For local testing without a domain, Resend's onboarding@resend.dev sender
# delivers to your own Resend account email.
RESEND_API_KEY=""
EMAIL_FROM="TeslaPrimeCapital <onboarding@resend.dev>"

# --- Smartsupp Live Chat (PUBLIC site key — safe to expose in the browser) ---
# Found in your Smartsupp dashboard: Settings > Chat box > Chat code.
# When unset, the floating live-chat widget is not rendered at all.
NEXT_PUBLIC_SMARTSUPP_KEY=""

# --- Public Site Origin (canonical URL — no trailing slash) ---
# Drives sitemap.xml, robots.txt host, canonical tags, and absolute Open Graph
# URLs. Set this to your production domain BEFORE deploying — every value the
# search engines see derives from it.
NEXT_PUBLIC_SITE_URL="https://www.teslaprimecapital.com"

# --- Verified Social Profiles (optional — rendered in the footer + fed to the
# Organization sameAs knowledge-graph). Leave blank to omit a profile entirely;
# dead or unverified handles must never be published.
NEXT_PUBLIC_SOCIAL_X_URL=""
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=""
NEXT_PUBLIC_SOCIAL_TELEGRAM_URL=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=""
