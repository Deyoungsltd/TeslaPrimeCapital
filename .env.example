# ============================================================================
# TeslaPrimeCapital — Environment Variable Registry
# Copy this file to `.env.local` and fill in each value for local development.
# ============================================================================

# --- Database (PostgreSQL) ---
# DATABASE_URL: runtime queries — use the POOLED connection string on Neon
# (host contains "-pooler") or any pgBouncer-fronted endpoint.
# DIRECT_URL: schema operations (prisma db push/migrate) — the same database
# WITHOUT "-pooler" in the host. Locally both can point at localhost.
# Alternative free providers if Neon is unreachable in your region:
#   Supabase  -> pooler  port 6543 => DATABASE_URL | direct port 5432 => DIRECT_URL
#                (Settings > Database > Connection string)
#   Aiven     -> free PostgreSQL plan, single endpoint used for both variables
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teslaprimecapital?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/teslaprimecapital?schema=public"

# --- Redis Cluster / Cache ---
# Upstash free tier: copy the TLS endpoint (rediss://, note the double-s).
# Alternative free providers if Upstash is unreachable in your region:
#   Redis Cloud (redis.com) -> free 30MB database; REDIS_URL format:
#     redis://default:<password>@<host>:<port>   (plain redis://, no TLS on free plan)
REDIS_URL="redis://localhost:6379/0"

# --- Cloudinary Secure Document Vault (KYC) ---
# Dashboard (home) > Product Environment Credentials. All three required —
# without them KYC uploads will fail loudly instead of faking success.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Authentication Cryptography ---
# Generate 64-char hex secrets locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=""
SESSION_MASTER_KEY=""

# --- Scheduled Accrual Cron (REQUIRED in production) ---
# Bearer secret that authorizes the daily 00:00 UTC settlement cycle endpoint
# (POST|GET /api/v1/cron/daily-accrual). Vercel Cron attaches it automatically
# as `Authorization: Bearer $CRON_SECRET` when this variable is set on the
# project. Generate 64-char hex the same way as the auth secrets (min 16).
CRON_SECRET=""

# --- Transactional Email (Resend) ---
# Sign up at resend.com, verify your sending domain, then paste the API key.
# For local testing without a domain, Resend's onboarding@resend.dev sender
# delivers to your own Resend account email.
RESEND_API_KEY=""
EMAIL_FROM="TeslaPrimeCapital <onboarding@resend.dev>"

# --- Smartsupp Live Chat (PUBLIC site key — safe to expose in the browser) ---
# Found in your Smartsupp dashboard: Settings > Chat box > Chat code.
# When unset, the floating live-chat widget is not rendered at all.
NEXT_PUBLIC_SMARTSUPP_KEY=""

# --- Public Site Origin (canonical URL — no trailing slash) ---
# Drives sitemap.xml, robots.txt host, canonical tags, and absolute Open Graph
# URLs. Set this to your production domain BEFORE deploying — every value the
# search engines see derives from it.
NEXT_PUBLIC_SITE_URL="https://www.teslaprimecapital.com"

# --- Verified Social Profiles (optional — rendered in the footer + fed to the
# Organization sameAs knowledge-graph). Leave blank to omit a profile entirely;
# dead or unverified handles must never be published.
NEXT_PUBLIC_SOCIAL_X_URL=""
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=""
NEXT_PUBLIC_SOCIAL_TELEGRAM_URL=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=""
